{
  "name": "ribbon-queue",
  "version": "1.0.0",
  "description": "Anonymous ribbon pickup queues for independent shops. Windows host, Android and iOS clients.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "start": "node src/server/index.mjs",
    "dev": "node src/server/index.mjs",
    "build": "vite build && node scripts/generate-sw.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "tsc --noEmit",
    "desktop": "electron .",
    "package:windows": "npm run build && electron-builder --win nsis portable --publish never",
    "native:sync": "npm run build && cap sync",
    "android:build": "node scripts/build-android.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "express": "5.3.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "sql.js": "1.16.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@types/qrcode": "1.5.6",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "org.ribbonqueue.desktop",
    "productName": "Ribbon Queue",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/client/**/*",
      "src/server/**/*",
      "desktop/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "Ribbon-Queue-${version}-Windows-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {"artifactName":"Ribbon-Queue-${version}-Windows-Portable.${ext}"},
    "npmRebuild": false
  }
}
